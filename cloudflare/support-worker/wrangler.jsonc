{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "universal-ai-studio-support",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "r2_buckets": [
    {
      "binding": "SUPPORT_BUCKET",
      "bucket_name": "universal-ai-studio-support-logs"
    }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "31002",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
